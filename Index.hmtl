<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>جوال جبران المفقود | iPhone RP Studio</title>
  <script>
    // viewers get a read-only phone; open with ?edit to customize
    if (!/[?&]edit(=|&|$)/.test(location.search)) document.documentElement.classList.add('view-only');
  </script>
  <style>
    .view-only [onclick*="openStudio"],
    .view-only #studio-modal,
    .view-only [onclick*="exportGitHubHtml"],
    .view-only [onclick*="openNewWaChatModal"],
    .view-only [onclick*="openWaChatSettings"],
    .view-only [onclick*="deleteWaMessage"],
    .view-only [onclick*="openSnapComposer"],
    .view-only [onclick*="deleteSnapStory"],
    .view-only [onclick*="saveSnapProfile"],
    .view-only [onclick="openNoteEditor(null)"],
    .view-only [onclick*="deleteCurrentNote"],
    .view-only button[onclick="saveAndCloseNote()"].bg-amber-500,
    .view-only [onclick*="openCallModal"],
    .view-only [onclick*="deleteCallEntry"],
    .view-only [onclick*="openProfileEditor"],
    .view-only [onclick*="openNewTweetModal"],
    .view-only [onclick*="deleteTweet"],
    .view-only [onclick*="openNewIgPostModal"],
    .view-only [onclick*="deleteIgPost"],
    .view-only #snap-viewer-delete,
    .view-only #lightbox-delete-btn,
    .view-only #wa-speaker-bar,
    .view-only label:has(#photos-upload-input),
    .view-only #photos-empty-state label { display: none !important; }
    .view-only #status-bar [onclick*="openStudio"] { display: flex !important; pointer-events: none; cursor: default !important; }
    .view-only label:has(input[type="file"]) { cursor: default !important; }
    .view-only #note-title-input,
    .view-only #note-content-input,
    .view-only #snap-edit-name,
    .view-only #snap-edit-user,
    .view-only #snap-edit-score { pointer-events: none; }
  </style>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Arabic Modern Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    :root {
      --font-arabic: 'IBM Plex Sans Arabic', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: var(--font-arabic);
      background: radial-gradient(circle at 50% 20%, #151821 0%, #07080b 100%);
      color: #ffffff;
      margin: 0;
      padding: 0;
      height: 100dvh;
      width: 100vw;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Desktop iPhone Chassis vs Mobile Fullscreen */
    .iphone-chassis {
      position: relative;
      width: 100%;
      height: 100dvh;
      background: #000000;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      background-size: cover;
      background-position: center;
    }

    @media (min-width: 640px) {
      .iphone-chassis {
        width: 393px;
        height: 852px;
        max-height: 94dvh;
        border-radius: 54px;
        border: 11px solid #1f2128;
        box-shadow:
          0 0 0 2px #363945,
          0 30px 80px rgba(0, 0, 0, 0.85),
          inset 0 0 20px rgba(255, 255, 255, 0.05);
      }
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .default-ios-wallpaper {
      background:
        radial-gradient(circle at 20% 20%, rgba(30, 58, 138, 0.35), transparent 45%),
        radial-gradient(circle at 80% 75%, rgba(16, 185, 129, 0.18), transparent 50%),
        radial-gradient(circle at 50% 50%, #0c0e14 0%, #030406 100%);
    }

    .ios-glass {
      background: rgba(28, 28, 32, 0.76);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border: 1px solid rgba(255, 255, 255, 0.11);
    }

    .ios-dock-glass {
      background: rgba(34, 34, 40, 0.72);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .app-view {
      position: absolute;
      inset: 0;
      z-index: 30;
      background: #000000;
      transform: scale(0.92);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.25s ease;
    }

    .app-view.active {
      transform: scale(1);
      opacity: 1;
      pointer-events: auto;
    }

    #lock-screen {
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
      background-size: cover;
      background-position: center;
    }

    #lock-screen.unlocked {
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
    }

    @keyframes floatUp {
      0%, 100% { transform: translateY(0); opacity: 0.75; }
      50% { transform: translateY(-6px); opacity: 1; }
    }
    .animate-swipe-hint {
      animation: floatUp 2s infinite ease-in-out;
    }

    .wa-bg {
      background-color: #0b141a;
      background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 0);
      background-size: 20px 20px;
    }

    .app-icon {
      width: 60px;
      height: 60px;
      border-radius: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.45);
      transition: transform 0.15s ease;
    }
    .app-icon:active {
      transform: scale(0.9);
    }

    /* Snapchat Story Progress Bar Animation */
    @keyframes storyFill {
      from { width: 0%; }
      to { width: 100%; }
    }
    .story-progress-active {
      animation: storyFill 5s linear forwards;
    }
  </style>
